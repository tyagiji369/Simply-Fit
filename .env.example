# Copy this file to .env and paste your free Google Gemini API key from https://aistudio.google.com
# Both key formats work: legacy Standard keys (start with AIza) and the new Auth keys (start with AQ.Ab).
# For the deployed Streamlit app, set the same key as a Streamlit Cloud secret:
#   GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_API_KEY=your_gemini_api_key_here
